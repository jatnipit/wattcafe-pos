# คัดลอกเป็น .env.local สำหรับรันบนเครื่อง
# ค่าของ Supabase local ดูได้จาก: npx supabase status
# ค่าของ production เก็บใน .env.hosted (ดู docs/setup-checklist.md)

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role ข้าม RLS ทั้งหมด: ใช้เฉพาะฝั่งเซิร์ฟเวอร์ ห้ามใส่ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# LINE Messaging API (สร้างช่องทางตาม docs/setup-checklist.md)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
