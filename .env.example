# ไฟล์ตัวอย่าง — agent แก้ได้ไฟล์นี้ไฟล์เดียว
# คัดลอกเป็น .env.local (รันบนเครื่อง) หรือ .env.hosted (production) แล้วเติมค่าเอง
# วิธีเขียนไฟล์จริง: docs/setup-checklist.md หัวข้อ "เขียนไฟล์ .env ด้วยตัวเอง"
# ค่า Supabase local ดูได้จาก: npx supabase status

# ---- Supabase (ใช้ทั้ง local และ production) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role ข้าม RLS ทั้งหมด: เฉพาะฝั่งเซิร์ฟเวอร์ ห้ามใส่ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Supabase CLI และ backup (เฉพาะ .env.hosted / GitHub Actions) ----
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ---- LINE Messaging API (checklist ข้อ 7) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- Google OAuth (checklist ข้อ 3-5) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- บัญชีเจ้าของร้าน (checklist ข้อ 6) ----
SUPER_ADMIN_EMAIL=

# ---- Cloudflare และ URL ของแอป (checklist ข้อ 8) ----
CLOUDFLARE_ACCOUNT_ID=
APP_BASE_URL=

# SUPABASE_ACCESS_TOKEN ไม่ได้อยู่ในไฟล์ env — เก็บเป็น GitHub secret (checklist ข้อ 9)
